INGEST_TOKEN=replace-with-a-long-random-secret
# Optional zero-downtime rotation slots. The reporter sends a matching key ID.
INGEST_TOKEN_NEXT=replace-with-the-next-long-random-secret
INGEST_TOKEN_PREVIOUS=replace-with-the-previous-long-random-secret
# Alternative for named rotation keys: {"current":"...","next":"..."}
INGEST_KEYS_JSON={"current":"replace-with-a-long-random-secret"}
# Optional keyed salt for hashed authentication-failure buckets. If omitted,
# INGEST_TOKEN is used; no source IP address is persisted.
AUTH_RATE_LIMIT_SALT=replace-with-a-different-long-random-secret
# Temporary migration only; signed v1.4 heartbeats do not need this.
ALLOW_LEGACY_INGEST_BEARER=0
VIEW_TOKEN=replace-with-a-different-long-random-secret
# Optional HTTPS destination for minimal state-change alerts.
ALERT_WEBHOOK_URL=https://example.com/mac-pulse-alert
ALERT_FALLBACK_WEBHOOK_URL=https://backup.example.com/mac-pulse-alert
# Optional external dead-man switch. It should alert when one-minute pings stop.
SCHEDULER_CANARY_URL=https://canary.example.com/mac-pulse-scheduler
